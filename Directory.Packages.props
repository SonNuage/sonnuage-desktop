<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bibliothèques partagées, publiées par la CI du dépôt sonnuage (registre NuGet du projet sonnuage/sonnuage).
         À monter avec le serveur : une version X.Y.Z publiée (tag), plutôt qu'un 0.1.0-ci.N de main, que le registre
         ne garde pas. -->
    <PackageVersion Include="SonNuage.UI" Version="1.10.0" />
    <!-- Photino : fenêtre et webview du système. La WebView Blazor suit la version d'ASP.NET Core du serveur. -->
    <PackageVersion Include="Photino.Blazor" Version="4.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- Tests : mêmes versions que le dépôt sonnuage. TrxReport suit Microsoft.Testing.Platform tiré par xunit.v3. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
  </ItemGroup>
</Project>
