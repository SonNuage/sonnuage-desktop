<?xml version="1.0" encoding="utf-8"?>
<!-- SonNuage.UI et SonNuage.Contracts viennent du registre NuGet du projet sonnuage/sonnuage (privé) :
     la CI s'y connecte avec son jeton de job ; en local, cloner sonnuage à côté de ce dépôt suffit
     (ses sources sont utilisées à la place du paquet, voir Directory.Build.props). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="sonnuage" value="https://git.pmjb.org/api/v4/projects/7/packages/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="sonnuage">
      <package pattern="SonNuage.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
